# =============================================================
#  SchedIQ — Timetable Manager (Flutter)
#  .gitignore — Comprehensive exclusions for this project
# =============================================================

# ─────────────────────────────────────────────
# FLUTTER / DART / PUB
# ─────────────────────────────────────────────
# Dart tool cache (package_config.json, etc.)
.dart_tool/

# Flutter plugin registry (auto-generated on flutter pub get)
.flutter-plugins
.flutter-plugins-dependencies

# Pub package cache
.pub-cache/
.pub/

# Flutter build output
/build/

# Coverage reports
/coverage/

# Dart generated code (if using build_runner)
*.g.dart
*.freezed.dart
*.gr.dart
*.mocks.dart

# Dart analysis cache
.dart_analysis_options

# Symbolication / obfuscation map files
app.*.symbols
app.*.map.json

# Flutter auto-generated launcher icons intermediate output
# (source PNGs in assets/icons/ are kept; generated mipmap outputs are in android/)
flutter_export_environment.sh


# ─────────────────────────────────────────────
# ANDROID
# ─────────────────────────────────────────────
# Gradle wrapper binary (generated)
android/gradle-wrapper.jar

# Gradle cache directories
android/.gradle/
android/.kotlin/

# Android Studio build artifacts
android/app/debug/
android/app/profile/
android/app/release/
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build outputs
android/build/
android/app/build/
android/captures/

# NDK/CMake compiled output
android/.cxx/
**/.cxx/

# Generated plugin registrant
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# Local machine properties (SDK/NDK paths — never commit)
android/local.properties

# Signing secrets — NEVER commit keystore or key properties
android/key.properties
**/*.keystore
**/*.jks

# Android IntelliJ module file (android-specific)
android/miniproject_timetable_manager_android.iml


# ─────────────────────────────────────────────
# APK / AAB BUILD ARTIFACTS
# ─────────────────────────────────────────────
# Release APKs at root level (built by build scripts)
*.apk
*.aab

# flutter build outputs inside build/
build/app/outputs/


# ─────────────────────────────────────────────
# iOS
# ─────────────────────────────────────────────
**/ios/Flutter/.last_build_id
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.perspectivev3
**/ios/**/*.xcworkspacedata
**/ios/**/*.xcuserstate
**/ios/DerivedData/
# CocoaPods
ios/Podfile.lock


# ─────────────────────────────────────────────
# macOS
# ─────────────────────────────────────────────
**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/
macos/Flutter/GeneratedPluginRegistrant.swift


# ─────────────────────────────────────────────
# WINDOWS
# ─────────────────────────────────────────────
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake
**/windows/flutter/ephemeral/


# ─────────────────────────────────────────────
# LINUX
# ─────────────────────────────────────────────
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake
**/linux/flutter/ephemeral/


# ─────────────────────────────────────────────
# WEB
# ─────────────────────────────────────────────
lib/generated_plugin_registrant.dart


# ─────────────────────────────────────────────
# SQLITE DATABASE (sqflite — runtime data)
# ─────────────────────────────────────────────
# The app's SQLite database is created at runtime; never commit user data
*.db
*.sqlite
*.sqlite3


# ─────────────────────────────────────────────
# PDF EXPORTS (printing / pdf packages)
# ─────────────────────────────────────────────
# PDFs generated by pdf_service.dart at runtime
*.pdf


# ─────────────────────────────────────────────
# IDE — IntelliJ / Android Studio
# ─────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
out/


# ─────────────────────────────────────────────
# IDE — VS Code
# ─────────────────────────────────────────────
# Keep .vscode/settings.json (it only sets Java config — safe to track)
# Exclude user-specific launch / task configs
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace


# ─────────────────────────────────────────────
# MISC / OS
# ─────────────────────────────────────────────
# macOS metadata
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# Windows thumbnails & system files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux trash
.Trash-*

# Vim / Nano swap files
*.swp
*.swo
*~

# Logs
*.log
*.class
*.pyc

# SVN / other VCS leftovers
.svn/
.atom/
.buildlog/
.history/
.swiftpm/
migrate_working_dir/


# ─────────────────────────────────────────────
# DOC / API (dart doc output)
# ─────────────────────────────────────────────
**/doc/api/


# ─────────────────────────────────────────────
# TEST CACHE
# ─────────────────────────────────────────────
.dart_tool/test/
